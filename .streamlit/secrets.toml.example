# Copy this file to .streamlit/secrets.toml (local use). That file is excluded by .gitignore and never goes to GitHub.
# On Streamlit Community Cloud do NOT use this file: paste the line below into Settings > Secrets of the app.

GDRIVE_FILE_ID = "PASTE_YOUR_GOOGLE_DRIVE_FILE_ID_HERE"      # upload data_export.zip to Drive (Anyone with the link: Viewer)
